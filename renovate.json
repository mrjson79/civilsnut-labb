{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Renovate configuration for the civilsnut-labbet Kubernetes cluster - fluxcd HelmReleases",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "timezone": "Europe/Stockholm",
  "minimumReleaseAge": "3 days",
  "dependencyDashboardAutoclose": true,
  "prConcurrentLimit": 10,
  "prHourlyLimit": 5,
  "platformAutomerge": true,
  "gitAuthor": "Renovate Bot <renovate@civilsnut.com>",
  "commitMessagePrefix": "chore:",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "to {{newVersion}}",
  "labels": ["dependencies"],
  "assignees": ["mrjson79"],
  "reviewers": ["mrjson79"],
  "ignorePaths": [
    "talos/**"
  ],
  "vulnerabilityAlerts": {
    "labels": ["security", "dependencies"],
    "assignees": ["mrjson79"],
    "reviewers": ["mrjson79"],
    "schedule": ["at any time"]
  },
  "flux": {
    "managerFilePatterns": ["/fluxcd/.+\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/fluxcd/.+\\.ya?ml$/"]
  },
  "packageRules": [
    {
      "description": "Automerge digest updates",
      "matchUpdateTypes": ["digest"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Critical security components - require manual review",
      "matchPackageNames": ["cert-manager", "external-secrets"],
      "automerge": false,
      "labels": ["security-critical"],
      "groupName": "Security Infrastructure"
    },
    {
      "description": "Networking components",
      "matchPackageNames": ["cilium"],
      "labels": ["networking"],
      "automerge": false,
      "groupName": "Networking Stack"
    },
    {
      "description": "Storage components",
      "matchPackageNames": ["rook-ceph", "rook-ceph-cluster"],
      "labels": ["storage"],
      "automerge": false,
      "groupName": "Storage Stack"
    },
    {
      "description": "Home automation",
      "matchPackageNames": [
        "home-assistant",
        "ghcr.io/home-assistant/home-assistant",
        "zigbee2mqtt",
        "eclipse-mosquitto",
        "kristofferR/FellowAiden-HomeAssistant",
        "nginx",
        "python"
      ],
      "labels": ["home-automation"],
      "automerge": false,
      "groupName": "Home Automation"
    },
    {
      "description": "Container images - patch updates can be auto-merged",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true,
      "automergeType": "pr",
      "labels": ["container-images", "automerge"]
    },
    {
      "description": "Non-critical Helm minor/patch - automerge for homelab",
      "matchDatasources": ["helm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "!cert-manager", "!external-secrets",
        "!cilium",
        "!rook-ceph", "!rook-ceph-cluster",
        "!cloudnative-pg"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "All other minor/patch updates",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "!cert-manager", "!external-secrets",
        "!cilium",
        "!rook-ceph", "!rook-ceph-cluster",
        "!cloudnative-pg"
      ],
      "groupName": "Other Dependencies",
      "groupSlug": "other-deps"
    },
    {
      "description": "Major updates require careful review",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["major-update"]
    },
    {
      "description": "Postgres majors need pg_upgrade planning - park behind dashboard approval",
      "matchPackageNames": ["postgres", "ghcr.io/cloudnative-pg/postgresql"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "alertmanager-webhook-signal moved from calver (22.x, 2022) to semver 1.x - the stale calver tags sort higher and must be blocked",
      "matchPackageNames": ["docker.io/schlauerlauer/alertmanager-webhook-signal"],
      "allowedVersions": "<20"
    }
  ],
  "customManagers": [
    {
      "description": "CNPG Cluster imageName is a CRD field the kubernetes manager cannot parse",
      "customType": "regex",
      "managerFilePatterns": ["/fluxcd/.+\\.ya?ml$/"],
      "matchStrings": ["imageName: (?<depName>ghcr\\.io/cloudnative-pg/postgresql):(?<currentValue>[\\w.\\-]+)"],
      "datasourceTemplate": "docker"
    },
    {
      "description": "Version tables in the READMEs - rows annotated with '<!-- renovate: ... -->' bump in the same PR as the manifest",
      "customType": "regex",
      "managerFilePatterns": ["/^README\\.md$/", "/^fluxcd/README\\.md$/"],
      "matchStrings": ["`?(?<currentValue>v?\\d[\\w.\\-]*)`? <!-- renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+?)(?: registryUrl=(?<registryUrl>\\S+?))? -->"]
    },
    {
      "description": "Fellow Aiden HA custom component is pinned in the home-assistant StatefulSet init container",
      "customType": "regex",
      "managerFilePatterns": ["/fluxcd/.+\\.ya?ml$/"],
      "matchStrings": ["VERSION=(?<currentValue>v[\\d.]+)\\n\\s+apk add --no-cache wget tar ca-certificates"],
      "depNameTemplate": "kristofferR/FellowAiden-HomeAssistant",
      "datasourceTemplate": "github-releases"
    },
    {
      "description": "prometheus-operator stripped-down CRDs are pulled by release URL in the kustomization",
      "customType": "regex",
      "managerFilePatterns": ["/fluxcd/.+\\.ya?ml$/"],
      "matchStrings": ["https://github\\.com/prometheus-operator/prometheus-operator/releases/download/(?<currentValue>v[\\d.]+)/"],
      "depNameTemplate": "prometheus-operator/prometheus-operator",
      "datasourceTemplate": "github-releases"
    }
  ],
  "hostRules": [
    {
      "matchHost": "charts.jetstack.io",
      "timeout": 30000
    },
    {
      "matchHost": "charts.external-secrets.io",
      "timeout": 30000
    },
    {
      "matchHost": "charts.rook.io",
      "timeout": 30000
    },
    {
      "matchHost": "charts.zigbee2mqtt.io",
      "timeout": 30000
    },
    {
      "matchHost": "helm.cilium.io",
      "timeout": 30000
    },
    {
      "matchHost": "kubernetes.github.io",
      "timeout": 30000
    },
    {
      "matchHost": "1password.github.io",
      "timeout": 30000
    }
  ],
  "ignoreDeps": ["localhost/**", "*:latest", "*:main"]
}
